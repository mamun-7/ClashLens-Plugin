<Window x:Class="ClashSolver.UI.HelpAssistance.WndCopilot"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:ClashSolver.UI.HelpAssistance"
             mc:Ignorable="d" Title="Copilot"
				Height="800" MinHeight="640"
				Width="320" MinWidth="240"
             d:DesignHeight="640" d:DesignWidth="240">
	<Window.Resources>
		<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
	</Window.Resources>
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="4*"/>
			<RowDefinition Height="3*"/>
			<RowDefinition Height="2*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBox Name="txtReply" Grid.Row="0" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
		<ListBox x:Name="listFAQ" Grid.Row="1" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
		<TextBox Name="txtQuery" Grid.Row="2" HorizontalAlignment="Stretch" VerticalAlignment="Stretch"/>
		<StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Center">
			<Button Name="btnClose" Content="Close" Style="{StaticResource FooterButtonStyle}"/>
			<Button Name="btnApply" Content="Appply" Style="{StaticResource FooterButtonStyle}"/>
		</StackPanel>
	</Grid>
</Window>
