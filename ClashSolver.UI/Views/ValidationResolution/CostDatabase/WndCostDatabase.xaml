<Window x:Class="ClashSolver.UI.ValidationResolution.CostDatabase.WndCostDatabase"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:ClashSolver.UI.ValidationResolution.CostDatabase"
						xmlns:util="clr-namespace:ClashSolver.UI"
						mc:Ignorable="d" Title="Cost Management"
						MinHeight="400" MinWidth="600"
						Height="450" Width="800"
						d:DesignHeight="450" d:DesignWidth="800">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<util:EnumDescriptionConverter x:Key="EnumConverter" />
		</ResourceDictionary>
	</Window.Resources>
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<GroupBox Grid.Row="0" Header="General" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Margin="5">
			<StackPanel Orientation="Horizontal" Margin="5">
				<TextBlock Text="Total Costs:" Style="{StaticResource NormalTextBlockStyle}"/>
				<TextBlock Text="{Binding TotalCost}" Width="100" Style="{StaticResource NormalTextBlockStyle}"/>
				
			</StackPanel>
		</GroupBox>
		<GroupBox Grid.Row="1" Header="Detail" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
			<DataGrid Name="gridIssues" Grid.Row="2" Margin="5" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Issues}">
				<DataGrid.Resources>
					<Style TargetType="DataGridColumnHeader">
						<Setter Property="HorizontalContentAlignment" Value="Center" />
					</Style>
				</DataGrid.Resources>
				<DataGrid.Columns>
					<DataGridTextColumn Header="ID" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
					<DataGridTextColumn Header="Description" Binding="{Binding Description}" IsReadOnly="True" Width="120"/>
					<DataGridTextColumn Header="Affected Elements" Binding="{Binding AffectElements}" IsReadOnly="True" Width="100"/>
					<DataGridTextColumn Header="Resolution Cost" Binding="{Binding ResolutionCost}" IsReadOnly="True" Width="100"/>
					<DataGridTextColumn Header="Severity" IsReadOnly="True" Width="80"/>
					<DataGridComboBoxColumn Header="Status" SelectedValueBinding="{Binding Status}" IsReadOnly="False" Width="100" />
					<DataGridComboBoxColumn Header="Visibility" SelectedValueBinding="{Binding Visibility}" IsReadOnly="False" Width="100"/>
				</DataGrid.Columns>
			</DataGrid>
		</GroupBox>

		<!-- Footer Buttons -->
		<StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,5,0,0">
			<Button Name="btnOK" Content="OK" Click="btnOK_Click" Style="{StaticResource FooterButtonStyle}"/>
			<Button Name="btnCancel" Content="Cancel" Click="btnCancel_Click" Style="{StaticResource FooterButtonStyle}"/>
		</StackPanel>
	</Grid>
</Window>
