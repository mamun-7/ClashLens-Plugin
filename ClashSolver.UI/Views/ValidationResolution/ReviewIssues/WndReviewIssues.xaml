<Window x:Class="ClashSolver.UI.ValidationResolution.ReviewIssues.WndReviewIssues"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:ClashSolver.UI.ValidationResolution.ReviewIssues"
						xmlns:model="clr-namespace:ClashSolver.UI"
						xmlns:control="clr-namespace:Components;assembly=Components"
						xmlns:util="clr-namespace:ClashSolver.UI"
            mc:Ignorable="d" Title="Review Issues"
						Width="800" Height="450"
						MinWidth="800" MinHeight="450"
             d:DesignHeight="450" d:DesignWidth="800" WindowStartupLocation="CenterScreen">

	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<util:EnumDescriptionConverter x:Key="EnumConverter" />
		</ResourceDictionary>
	</Window.Resources>

	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<!--Header Status Section-->
		<StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Left">
			<TextBlock Text="Validation Time:" Style="{StaticResource BoldTextBlockStyle}"/>
			<TextBlock Text="{Binding ValidationTime}" Style="{StaticResource NormalTextBlockStyle}"/>
		</StackPanel>
		
		<!-- By Clash Detection Set -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Left">
			<CheckBox Name="chkFilterByClashSet" Content="Filter By Clash Detection Set" IsChecked="{Binding IsFilterBySet}" Style="{StaticResource CheckBoxStyle}"/>
			<control:MultiSelectComboBox x:Name="mselFilters" Width="300" Height="20" ItemsSource="{Binding FilterSets}" SelectedItems="{Binding SelectedFilterSets}" IsEnabled="{Binding IsChecked, ElementName=chkFilterByClashSet}"/>
		</StackPanel>

		<!--Issue Grid Section-->
		
		<DataGrid Name="gridIssues" Grid.Row="2" Margin="5" AutoGenerateColumns="False" CanUserAddRows="False" ItemsSource="{Binding Issues}" SelectionChanged="gridIssues_SelectionChanged" MouseDoubleClick="gridIssues_MouseDoubleClick">
			<DataGrid.Resources>
				<Style TargetType="DataGridColumnHeader">
					<Setter Property="HorizontalContentAlignment" Value="Center" />
				</Style>
			</DataGrid.Resources>
			<DataGrid.Columns>
				<DataGridTextColumn Header="No" Binding="{Binding Id}" IsReadOnly="True" Width="50"/>
				<DataGridTextColumn Header="Content" Binding="{Binding Content}" IsReadOnly="True" Width="120"/>
				<DataGridTextColumn Header="Category1" Binding="{Binding CategoryA.Name}" IsReadOnly="True" Width="100"/>
				<DataGridTextColumn Header="Category2" Binding="{Binding CategoryB.Name}" IsReadOnly="True" Width="100"/>
				<DataGridTextColumn Header="Severity" IsReadOnly="True" Width="80"/>
				<DataGridComboBoxColumn Header="Status" SelectedValueBinding="{Binding Status}" IsReadOnly="False" Width="100" >
				</DataGridComboBoxColumn>
				<DataGridComboBoxColumn Header="Visibility" SelectedValueBinding="{Binding Visibility}" IsReadOnly="False" Width="100"/>
				<DataGridTemplateColumn Header="AI Solution" IsReadOnly="False" Width="100">
					<DataGridTemplateColumn.CellTemplate>
						<DataTemplate>
							<Button x:Name="btnAIResolve" Content="{Binding ResolveStatus}" Click="btnAIResolve_Click"/>
						</DataTemplate>
					</DataGridTemplateColumn.CellTemplate>
					
				</DataGridTemplateColumn>
			</DataGrid.Columns>
		</DataGrid>
		
		<!--For Pagination-->
		<Grid Grid.Row="3">
			<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="5">
				<Button x:Name="btnPrevious" Content="&lt;" Width="30"  Margin="0,5" Style="{StaticResource SmallButtonStyle}" Click="btnPrevious_Click"/>
				<TextBox x:Name="txtPage" Text="{Binding CurrentPageNumber}" VerticalAlignment="Center" Style="{StaticResource SmallTextBoxStyle}"/>
				<TextBlock Text="of " Margin="0,5" Style="{StaticResource NormalTextBlockStyle}"/>
				<TextBlock Text="{Binding PageCount}" Style="{StaticResource NormalTextBlockStyle}"/>
				<TextBlock Text=" Pages" Margin="0,5" Style="{StaticResource NormalTextBlockStyle}"/>
				<Button x:Name="btnNext" Content="&gt;" Width="30" Margin="5,5,0,5" Style="{StaticResource SmallButtonStyle}" Click="btnNext_Click"/>
			</StackPanel>
		</Grid>

		<!--Selection and Manipulation-->
		<Grid Grid.Row="4">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>

			<GroupBox Grid.Column="0" Header="Selection" Margin="5">
				<StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
					<Button Name="btnSelAll" Content="All" Style="{StaticResource ContentButtonStyle}" Click="btnSelAll_Click"/>
					<Button Name="btnSelNone" Content="None" Style="{StaticResource ContentButtonStyle}" Click="btnSelNone_Click"/>
					<Button Name="btnSelInvert" Content="Invert" Style="{StaticResource ContentButtonStyle}" Click="btnSelInvert_Click"/>
				</StackPanel>
			</GroupBox>
			<StackPanel Grid.Column="2" Orientation="Vertical" VerticalAlignment="Center">
				<TextBlock Text="Visibility:" Style="{StaticResource NormalTextBlockStyle}"/>
				<ComboBox Name="cmbVisibility" SelectedValue="{Binding ByVisibility}" Style="{StaticResource NormalComboBoxStyle}">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>
			<StackPanel Grid.Column="3" Orientation="Vertical" VerticalAlignment="Center">
				<TextBlock Text="Status as:" Style="{StaticResource NormalTextBlockStyle}"/>
				<ComboBox Name="cmbStatus" SelectedValue="{Binding ByStatus}" Style="{StaticResource NormalComboBoxStyle}" SelectionChanged="cmbStatus_SelectionChanged">
					<ComboBox.ItemTemplate>
						<DataTemplate>
							<TextBlock Text="{Binding Converter={StaticResource EnumConverter}}" />
						</DataTemplate>
					</ComboBox.ItemTemplate>
				</ComboBox>
			</StackPanel>
		</Grid>

		<!--Footer Section-->
		<Grid Grid.Row="5">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="*"/>
				<ColumnDefinition Width="Auto"/>
			</Grid.ColumnDefinitions>
			
			<StackPanel Grid.Column="0" Orientation="Horizontal">
				<TextBlock Text="Preset:" Style="{StaticResource NormalTextBlockStyle}"/>
				<ComboBox Name="cmbPreset" Style="{StaticResource LargeComboBoxStyle}">

				</ComboBox>
				<Button Content="..." Name="btnPresetDelete" Style="{StaticResource SymbolButtonStyle}"/>
			</StackPanel>
			
			<StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
				<Button Name="btnRerunValidation" Content="Rerun Validation" Style="{StaticResource FooterButtonStyle}"/>
				<Button Name="btnReport" Content="Report..." Style="{StaticResource FooterButtonStyle}"/>
				<Button Name="btnDone" Content="Done" Style="{StaticResource FooterButtonStyle}"/>
				<Button Name="btnCopilot" Content="Copilot >>" Style="{StaticResource FooterButtonStyle}"/>
			</StackPanel>
		</Grid>
		
	</Grid>
</Window>