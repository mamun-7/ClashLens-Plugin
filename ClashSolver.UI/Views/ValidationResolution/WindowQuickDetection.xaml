<Window x:Class="ClashSolver.UI.Views.ValidationResolution.WindowQuickDetection"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:ClashSolver.UI.Views.ValidationResolution"
            mc:Ignorable="d" 
				    Title="Quick Clash Detection"
						MinHeight="300" MinWidth="600"
						Height="400" Width="600"
            d:DesignHeight="400" d:DesignWidth="600">

	<Window.Resources>
		<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
	</Window.Resources>
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>

		<!-- Consultant Links Section -->
		<GroupBox
							Grid.Row="0"
							Header="Select Link Models"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch">
			<ListBox x:Name="listLinkModels" ItemsSource="{Binding LinkedModels}">
				<ListBox.ItemTemplate>
					<DataTemplate>
						<Grid Margin="5" HorizontalAlignment="Stretch">
							<Grid.ColumnDefinitions>
								<ColumnDefinition Width="*"/>
								<ColumnDefinition Width="*" MinWidth="400"/>
								<ColumnDefinition Width="*"/>
							</Grid.ColumnDefinitions>
							<CheckBox Grid.Column="0" VerticalAlignment="Center" IsChecked="{Binding Selected}" Style="{StaticResource CheckBoxStyle}"/>
							<TextBlock Grid.Column="1" Text="{Binding Name}" VerticalAlignment="Center" Style="{StaticResource NormalTextBlockStyle}"/>
							<TextBlock Grid.Column="2" Text="{Binding DisciplineStr}" VerticalAlignment="Center" Style="{StaticResource NormalTextBlockStyle}"/>
						</Grid>
					</DataTemplate>
				</ListBox.ItemTemplate>
			</ListBox>
		</GroupBox>

		<!-- Footer Buttons -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,5,0,0">
			<Button Name="btnOK" Content="OK" Click="btnOK_Click" Style="{StaticResource FooterButtonStyle}"/>
			<Button Name="btnCancel" Content="Cancel" Click="btnCancel_Click" Style="{StaticResource FooterButtonStyle}"/>
		</StackPanel>
	</Grid>
</Window>
