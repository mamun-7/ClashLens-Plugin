<Window x:Class="ClashSolver.UI.SettingsUtilities.WindowComplianceSetting"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:ClashSolver.UI.SettingsUtilities"
            mc:Ignorable="d" Title="Compliance Settings"
						MinHeight="300" MinWidth="600"
						Height="450" Width="800"
            d:DesignHeight="450" d:DesignWidth="800" WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="40"/>
		</Grid.RowDefinitions>

		<TabControl Margin="0">
			<TabItem Header="Applied Code">
				<Grid Margin="5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="35"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Text="Applicable Code Types:" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource NormalTextBlockStyle}"/>
					<TreeView Grid.Row="1" Grid.Column="0" Margin="5">
					</TreeView>

					<StackPanel Orientation="Horizontal" Margin="5" Grid.Row="0" Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Left">
						<TextBlock Text="Applied Building Codes:" Margin="0" VerticalAlignment="Center" Style="{StaticResource NormalTextBlockStyle}"/>
						<Button Content="Import..." Margin="100,0,0,0" VerticalAlignment="Center" HorizontalAlignment="Left" Style="{StaticResource MediumButtonStyle}" />
					</StackPanel>
					<DataGrid AutoGenerateColumns="False" Grid.Row="1" Grid.Column="1" Margin="5">
						<DataGrid.Resources>
							<Style TargetType="DataGridColumnHeader">
								<Setter Property="HorizontalContentAlignment" Value="Center" />
							</Style>
						</DataGrid.Resources>
						<DataGrid.Columns>
							<DataGridTextColumn Header=" " Width="30"/>
							<DataGridTextColumn Header="Code Title" Width="100"/>
							<DataGridTextColumn Header="Code ID" Width="100"/>
							<DataGridTextColumn Header="Version" Width="70"/>
							<DataGridTextColumn Header="Description" Width="200"/>
							<DataGridTextColumn Header="Link" Width="200"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</TabItem>
			<TabItem Header="User-Defined Rules" Height="22" VerticalAlignment="Top">
				<Grid>
					<Grid.RowDefinitions>
						<RowDefinition Height="35"/>
						<RowDefinition Height="35"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>
					<TextBlock Grid.Row="0" Grid.Column="0" Text="Customization to:" Margin="10,0,0,0" Style="{StaticResource NormalTextBlockStyle}"/>
					<ComboBox Grid.Row="0" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource LargeComboBoxStyle}"/>

					<TextBlock Grid.Row="1" Grid.Column="0" Text="Sections Related to:" Margin="10,0,0,0" Style="{StaticResource NormalTextBlockStyle}"/>
					<ComboBox Grid.Row="1" Grid.Column="1" HorizontalAlignment="Left" Style="{StaticResource LargeComboBoxStyle}"/>

					<TreeView Margin="5" Grid.Row="2" Grid.Column="0"/>
					<DataGrid Margin="5" Grid.Row="2" Grid.Column="1">
						<DataGrid.Resources>
							<Style TargetType="DataGridColumnHeader">
								<Setter Property="HorizontalContentAlignment" Value="Center" />
							</Style>
						</DataGrid.Resources>
						<DataGrid.Columns>
							<DataGridTextColumn Header="Rule ID" Width="80"/>
							<DataGridTextColumn Header="Description" Width="200"/>
							<DataGridTextColumn Header="Value" Width="80"/>
							<DataGridTextColumn Header="Type" Width="150"/>
							<DataGridTextColumn Header="User-defined" Width="80"/>
						</DataGrid.Columns>
					</DataGrid>
				</Grid>
			</TabItem>
			<TabItem Header="Localization">
				<Grid Margin="5">
					<Grid.ColumnDefinitions>
						<ColumnDefinition Width=".5*"/>
						<ColumnDefinition Width="1*"/>
						<ColumnDefinition Width="3*"/>
					</Grid.ColumnDefinitions>
					<Grid.RowDefinitions>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="Auto"/>
						<RowDefinition Height="*"/>
					</Grid.RowDefinitions>

					<TextBlock Text="Country:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="0" Grid.Row="0" Style="{StaticResource NormalTextBlockStyle}"/>
					<ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" Grid.Row="0" Style="{StaticResource NormalComboBoxStyle}"/>
					<TextBlock Text="Region:" HorizontalAlignment="Right" VerticalAlignment="Center" Grid.Column="0" Grid.Row="1" Style="{StaticResource NormalTextBlockStyle}"/>
					<ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" Grid.Row="1" Style="{StaticResource NormalComboBoxStyle}"/>
					<TextBlock Text="Building Code Description Language:" HorizontalAlignment="Left" VerticalAlignment="Center" Grid.Column="0" Grid.ColumnSpan="2" Grid.Row="2" Style="{StaticResource NormalTextBlockStyle}"/>
					<ComboBox HorizontalAlignment="Stretch" VerticalAlignment="Center" Grid.Column="1" Grid.Row="3" Style="{StaticResource NormalComboBoxStyle}"/>
					<TextBlock Text="Climate:" HorizontalAlignment="Right" VerticalAlignment="Top" Grid.Column="0" Grid.Row="4" Style="{StaticResource NormalTextBlockStyle}"/>
				</Grid>
			</TabItem>
		</TabControl>

		<Grid Grid.Row="1">
			<Grid.ColumnDefinitions>
				<ColumnDefinition Width="Auto"/>
				<ColumnDefinition Width="*"/>
			</Grid.ColumnDefinitions>

			<StackPanel VerticalAlignment="Center" HorizontalAlignment="Left" Orientation="Horizontal">
				<TextBlock x:Name="leblTopPreset" Text="Preset:" VerticalAlignment="Center" Style="{StaticResource NormalTextBlockStyle}"/>
				<ComboBox x:Name="chkPreset" Style="{StaticResource LargeComboBoxStyle}"/>
				<Button Width="25" Content = "..."  Style="{StaticResource SymbolButtonStyle}"/>
			</StackPanel>
			<StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal">
				<Button x:Name="btnOk" Content="OK" Style="{StaticResource FooterButtonStyle}" Click="btnOk_Click"/>
				<Button x:Name="bntnCancel" Content="Cancel" Style="{StaticResource FooterButtonStyle}" Click="bntnCancel_Click"/>
				<Button x:Name="btnCopilot" Content="Copilot >>" HorizontalAlignment="Right" Style="{StaticResource FooterButtonStyle}" Click="btnCopilot_Click"/>
			</StackPanel>
		</Grid>
  </Grid>
</Window>
