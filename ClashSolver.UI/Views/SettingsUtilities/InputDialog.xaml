<Window x:Class="ClashSolver.UI.Views.SettingsUtilities.InputDialog"
				xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
				xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
				xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
				xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
				xmlns:local="clr-namespace:ClashSolver.UI.Views.SettingsUtilities"
				mc:Ignorable="d" 
				Title="Input Name" Height="150" Width="300" WindowStartupLocation="CenterOwner">
	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock Text="Enter Name:" VerticalAlignment="Center" Margin="0,0,0,10"/>
		<TextBox x:Name="txtName" Grid.Row="1" Margin="0,0,0,10"/>
		<StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
			<Button Content="OK" Width="75" Margin="5" Click="OkButton_Click"/>
			<Button Content="Cancel" Width="75" Margin="5" Click="CancelButton_Click"/>
		</StackPanel>
	</Grid>
</Window>
