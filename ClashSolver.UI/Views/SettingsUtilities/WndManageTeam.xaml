<Window x:Class="ClashSolver.UI.SettingsUtilities.WndManageTeam"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:ClashSolver.UI.SettingsUtilities"
            mc:Ignorable="d"
						Title="Collaboration Team Managment" 
						MinHeight="300" MinWidth="600"
						Height="450" Width="800"
						d:DesignHeight="450" d:DesignWidth="800">

	<Window.Resources>
		<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
	</Window.Resources>

	<!-- Main grid for Table and Buttons -->
	<Grid Margin="10">

		<!-- Sidebar Buttons -->
		<StackPanel Orientation="Vertical" HorizontalAlignment="left" VerticalAlignment="Center" Width="40">
			<Button x:Name="btnAdd" Content="+" ToolTip="Add Member" Style="{StaticResource SymbolButtonStyle}"/>
			<Button x:Name="btnRemove" Content="-" ToolTip="Remove Member" Style="{StaticResource SymbolButtonStyle}"/>
			<Button x:Name="btnMoveUp" Content="↑" ToolTip="Move Up" Style="{StaticResource SymbolButtonStyle}"/>
			<Button x:Name="btnMoveDown" Content="↓" ToolTip="Move Down" Style="{StaticResource SymbolButtonStyle}"/>
			<Button x:Name="btnClear" Content="X" ToolTip="Clear Selection" Style="{StaticResource SymbolButtonStyle}"/>
			
		</StackPanel>

		<!-- Label -->
		<TextBlock Text="Team Members:" FontWeight="Bold" Margin="40, 10,10,10" VerticalAlignment="Top" HorizontalAlignment="Left" Style="{StaticResource BoldTextBlockStyle}"/>
		<!-- DataGrid -->
		<DataGrid x:Name="TeamMemberDataGrid"
							AutoGenerateColumns="False"
							Margin="40,30,10,40"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							CanUserAddRows="False"
							CanUserDeleteRows="False">
			<!-- Columns -->
			<DataGrid.Columns>
				<DataGridTextColumn Header="No" Width="50" Binding="{Binding Number}" />
				<DataGridTextColumn Header="Name" Width="100" Binding="{Binding Name}" />
				<DataGridTextColumn Header="Email Address" Width="150" Binding="{Binding Email}" />
				<DataGridComboBoxColumn Header="Responsibilities" Width="100" SelectedItemBinding="{Binding Discipline}" />
				<DataGridTextColumn Header="Note" Width="150" Binding="{Binding Note}" />
			</DataGrid.Columns>
		</DataGrid>

		<!-- Footer Buttons -->
		<StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,0,5,5">
			<Button x:Name="btnOk" Content="OK" Style="{StaticResource FooterButtonStyle}"/>
			<Button x:Name="btnCancel" Content="Cancel" Style="{StaticResource FooterButtonStyle}"/>
		</StackPanel>
	</Grid>
</Window>
