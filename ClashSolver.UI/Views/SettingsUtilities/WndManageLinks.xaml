<Window x:Class="ClashSolver.UI.SettingsUtilities.WndManageLinks"
							xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
							xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
							xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
							xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
							xmlns:local="clr-namespace:ClashSolver.UI.SettingsUtilities"
							xmlns:util="clr-namespace:ClashSolver.UI"
							xmlns:model="clr-namespace:ClashSolver.UI"
							xmlns:sys="clr-namespace:System;assembly=mscorlib"
             mc:Ignorable="d" Title="Manage Consultant Links"
             d:DesignHeight="450" d:DesignWidth="800"
							MinWidth="800" MinHeight="400"
							Width="800" Height="450" WindowStartupLocation="CenterScreen">
	<Window.Resources>
		<ResourceDictionary>
			<ResourceDictionary.MergedDictionaries>
				<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
			</ResourceDictionary.MergedDictionaries>
			<util:EnumDescriptionConverter x:Key="EnumConverter"/>
			<ObjectDataProvider x:Key="DisciplineEnumValues" MethodName="GetValues" ObjectType="{x:Type sys:Enum}">
				<ObjectDataProvider.MethodParameters>
					<x:Type TypeName="model:LinkDiscipline"/>
				</ObjectDataProvider.MethodParameters>
			</ObjectDataProvider>
		</ResourceDictionary>
	</Window.Resources>

	<Grid Margin="10">
		<Grid.RowDefinitions>
			<RowDefinition Height="*" />
			<RowDefinition Height="Auto" />
		</Grid.RowDefinitions>
		<!-- Consultant Links Section -->
		<GroupBox
							Grid.Row="0"
							Header="Consultant Links:"
							HorizontalAlignment="Stretch"
							VerticalAlignment="Stretch"
							Margin="0,5,0,0">
			<Grid>
				<Grid.ColumnDefinitions>
					<ColumnDefinition Width="Auto"/>
					<ColumnDefinition Width="*"/>
				</Grid.ColumnDefinitions>
				<!-- Sidebar Buttons -->
				<!--<StackPanel Grid.Column="0" Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5">
					<Button Name="btnAdd" Content="+" ToolTip="Add Row" Click="btnAdd_Click" Style="{StaticResource NewButtonStyle}"/>
					<Button Name="btnRemove" Content="-" ToolTip="Remove Row" Click="btnRemove_Click" Style="{StaticResource DeleteButtonStyle}"/>
					<Button Name="btnUp" Content="↑" ToolTip="Move Up" Click="btnUp_Click" Style="{StaticResource UpButtonStyle}"/>
					<Button Name="btnDown" Content="↓" ToolTip="Move Down" Click="btnDown_Click" Style="{StaticResource DownButtonStyle}"/>
				</StackPanel>-->

				<!-- Data Grid -->
				<DataGrid Grid.Column="1"
									x:Name="ConsultantLinksGrid"
									Margin="5"
									AutoGenerateColumns="False"
									CanUserAddRows="False"
									ItemsSource="{Binding LinkedModels}">
					<DataGrid.Resources>
						<Style TargetType="DataGridColumnHeader">
							<Setter Property="HorizontalContentAlignment" Value="Center" />
						</Style>
					</DataGrid.Resources>
					<DataGrid.Columns>
						<!--<DataGridTextColumn Header="No" Width="50" Binding="{Binding No}" IsReadOnly="True" />-->
						<DataGridTemplateColumn Header="Name" Width="Auto">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<TextBlock Text="{Binding Name}" Style="{StaticResource NormalTextBlockStyle}"/>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Url" Width="300" Visibility="Collapsed">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<StackPanel Orientation="Horizontal">
										<TextBox Text="{Binding Url}" Width="230" IsReadOnly="True" Margin="0,0,5,0"/>
										<Button Name="btnBrowse" Content="Browse" Click="btnBrowse_Click" Tag="{Binding}" Width="70"/>
									</StackPanel>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTemplateColumn Header="Discipline" Width="200">
							<DataGridTemplateColumn.CellTemplate>
								<DataTemplate>
									<ComboBox Name="cmbDiscipline" ItemsSource="{Binding Source={StaticResource DisciplineEnumValues}}" SelectedItem="{Binding Discipline}" Margin="0" Width="Auto" Style="{StaticResource NormalComboBoxStyle}" SelectionChanged="cmbDiscipline_SelectionChanged">
										<ComboBox.ItemTemplate>
											<DataTemplate>
												<TextBlock Text="{Binding Converter={StaticResource EnumConverter}}"/>
											</DataTemplate>
										</ComboBox.ItemTemplate>
									</ComboBox>
								</DataTemplate>
							</DataGridTemplateColumn.CellTemplate>
						</DataGridTemplateColumn>
						<DataGridTextColumn Header="Assignee" Width="150" Binding="{Binding Assignee}"/>
						<DataGridTextColumn Header="Description" Width="200" Binding="{Binding Description}"/>
					</DataGrid.Columns>
				</DataGrid>
			</Grid>
		</GroupBox>

		<!-- Footer Buttons -->
		<StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="0,5,0,0">
			<Button Name="btnOK" Content="OK" Click="btnOK_Click" Style="{StaticResource FooterButtonStyle}"/>
			<Button Name="btnCancel" Content="Cancel" Click="btnCancel_Click" Style="{StaticResource FooterButtonStyle}"/>
		</StackPanel>
	</Grid>
</Window>
