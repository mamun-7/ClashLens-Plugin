<Window x:Class="ClashSolver.UI.UIComponents.WindowColumnVisibility"
            xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
            xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
            xmlns:local="clr-namespace:ClashSolver.UI.UIComponents"
            mc:Ignorable="d" 
		    Title="show/Hide Columns"
            Height="300" Width="250">
    <StackPanel Margin="10">
		<ItemsControl x:Name="ColumnsList">
			<ItemsControl.ItemTemplate>
				<DataTemplate>
					<CheckBox Content="{Binding Header}" IsChecked="{Binding IsVisible, Mode=TwoWay}"/>
				</DataTemplate>
			</ItemsControl.ItemTemplate>
		</ItemsControl>
		<Button Content="OK" Margin="0,10,0,0" HorizontalAlignment="Right" Width="60" Click="OnOK_Click"/>
	</StackPanel>
</Window>
