<UserControl x:Class="ClashSolver.UI.UIComponents.SelectControl"
					xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
					xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
					xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
					xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
					xmlns:local="clr-namespace:ClashSolver.UI.UIComponents"
					mc:Ignorable="d" 
					d:DesignHeight="450" d:DesignWidth="300">
	<UserControl.Resources>
		<ResourceDictionary Source="pack://application:,,,/ClashSolver.UI;component/Common/Generic.xaml"/>
	</UserControl.Resources>
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<ListBox x:Name="listBox" Grid.Row="0" ItemsSource="{Binding Items}" SelectionMode="Single">
			<ListBox.ItemTemplate>
				<DataTemplate>
					<StackPanel Orientation="Horizontal">
						<CheckBox x:Name="SelectCheckBox" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Style="{StaticResource CheckBoxStyle}" Checked="SelectCheckBox_Checked" Unchecked="SelectCheckBox_Unchecked"/>
						<TextBlock Text="{Binding Name}" VerticalAlignment="Center" Style="{StaticResource NormalTextBlockStyle}"/>
					</StackPanel>
				</DataTemplate>
			</ListBox.ItemTemplate>
		</ListBox>

		<StackPanel Grid.Row="1" Orientation="Horizontal"
 HorizontalAlignment="Left" Margin="5">
			<Button x:Name="All" Content="SelectAll" Margin="0,5,0,5" Style="{StaticResource SmallButtonStyle}" Click="SelectAll_Click"/>
			<Button x:Name="SelectNone" Content="None" Style="{StaticResource SmallButtonStyle}" Click="SelectNone_Click"/>
			<Button x:Name="SelectInvert" Content="Invert" Margin="5,5,0,5" Style="{StaticResource SmallButtonStyle}" Click="SelectInvert_Click"/>
		</StackPanel>
	</Grid>
</UserControl>
