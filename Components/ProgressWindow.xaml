<Window x:Class="Components.ProgressWindow"
							xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
							xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
							xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
							xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
							xmlns:local="clr-namespace:Components"
							mc:Ignorable="d"
							DataContext="{Binding RelativeSource={RelativeSource Self}}"
							Title="ProgressBarWindow"
							Height="150" Width="400"
							d:DesignHeight="120" d:DesignWidth="400" ResizeMode="NoResize">
	<Grid Margin="5">
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>
		<TextBlock Grid.Row="0" Text="{Binding Message}" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30"/>
		<ProgressBar Grid.Row="1" Visibility="Visible" Height="30" Value="{Binding Percentage}" Minimum="{Binding MinValue}" Maximum="{Binding MaxValue}" Margin="0,5,0,5"/>
		<TextBlock Grid.Row="2" Text="{Binding Description}" HorizontalAlignment="Center" VerticalAlignment="Center" Height="30"/>
	</Grid>
</Window>
